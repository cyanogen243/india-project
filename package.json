{
  "name": "the-india-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run db:setup && next dev",
    "build": "node scripts/validate-content.mjs && node scripts/build-feed.mjs && node scripts/check-security.mjs && next build",
    "start": "next start",
    "build:feed": "node scripts/build-feed.mjs",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:security": "node scripts/check-security.mjs",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:check": "tsx scripts/check-database.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "db:generate": "drizzle-kit generate",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run build && node --test tests/vercel-rendered-html.test.mjs tests/contribution-lifecycle.test.mjs tests/storage-driver.test.mjs",
    "test:unit": "tsx --test tests/volunteer-filter.test.ts tests/request-identity.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .output --ignore-pattern .astro --ignore-pattern .netlify --ignore-pattern dist-demo --ignore-pattern test-results",
    "seed:art": "tsx scripts/seed-contributions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.14",
    "sharp": "0.35.0",
    "ws": "8.21.1"
  },
  "type": "module"
}
