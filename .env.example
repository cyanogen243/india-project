# Local development works with this file URL. The data directory is ignored.
LIBSQL_URL=file:./data/the-india-project.db

# Required only when LIBSQL_URL points to a hosted Turso/libSQL database.
LIBSQL_AUTH_TOKEN=

# The Vercel Turso integration injects these names automatically. They are
# accepted as fallbacks when the matching LIBSQL_* values are not set.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Generate independent high-entropy values for deployed environments.
SESSION_SECRET=
RATE_LIMIT_SECRET=

# Ed25519 PKCS8 private key. Keep it secret and use literal \n characters in
# single-line environment dashboards. Local editors may instead use the
# ignored .private/feed-private.pem file.
FEED_SIGNING_PRIVATE_KEY=

# Public canonical URL for social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Object storage for gallery images (any S3-compatible bucket). Without these
# the storage driver falls back to local disk, which cannot work on a
# serverless host — set them before deploying the contribution wall.
ART_S3_ENDPOINT=
ART_S3_BUCKET=
ART_S3_ACCESS_KEY_ID=
ART_S3_SECRET_ACCESS_KEY=
ART_S3_REGION=
