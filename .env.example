# Local development works with this file URL. The data directory is ignored.
# REQUIRED IN PRODUCTION. The local-file value below is a development
# convenience; in production the app refuses to start without a hosted
# database, since a serverless filesystem does not persist between requests.
LIBSQL_URL=file:./data/the-india-project.db

# Required only when LIBSQL_URL points to a hosted Turso/libSQL database.
LIBSQL_AUTH_TOKEN=

# The Vercel Turso integration injects these names automatically. They are
# accepted as fallbacks when the matching LIBSQL_* values are not set.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Generate independent high-entropy values for deployed environments.
SESSION_SECRET=
RATE_LIMIT_SECRET=

# Ed25519 PKCS8 private key. Keep it secret and use literal \n characters in
# single-line environment dashboards. Local editors may instead use the
# ignored .private/feed-private.pem file.
FEED_SIGNING_PRIVATE_KEY=

# Public canonical URL for social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Object storage for gallery images (any S3-compatible bucket).
# OPTIONAL IN DEVELOPMENT, REQUIRED IN PRODUCTION. Left unset locally, the
# driver writes to the ignored data/uploads directory. In production it
# refuses to start instead of falling back: a serverless host discards its
# filesystem between requests, so the fallback would accept uploads that are
# gone by the next request with database rows still pointing at them.
# All four must be set together — a partial set is refused in every
# environment, because three of four is almost always a typo.
# ART_S3_REGION defaults to "auto", which only Cloudflare R2 accepts. Most
# providers verify the signing region and reject a mismatch with a 403 that
# reads like bad credentials. Use the region from the endpoint host: for
# https://s3.eu-west-par.io.cloud.ovh.net that is "eu-west-par".
# Run `npm run check:storage` to confirm a bucket before deploying against it.
ART_S3_ENDPOINT=
ART_S3_BUCKET=
ART_S3_ACCESS_KEY_ID=
ART_S3_SECRET_ACCESS_KEY=
ART_S3_REGION=
