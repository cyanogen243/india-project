# No environment variables are required to build or run a fresh clone.
#
# Authorized publishers may provide the existing Ed25519 private key to
# regenerate public/feed/updates.json and public/feed/updates.sig.
# Keep the real value in the hosting provider's secret store, never in Git.
FEED_SIGNING_PRIVATE_KEY=

# Set only on a trusted local machine to create a new signing identity.
# GENERATE_LOCAL_FEED_KEY=true
